# ==========================================
# MIRTA COSMÉTICA - VARIABLES DE ENTORNO
# ==========================================

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1. SUPABASE (Base de datos, Auth y Storage)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase

# 2. MERCADO PAGO (Checkout Pro + Webhooks)
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-tu-public-key
MP_ACCESS_TOKEN=APP_USR-tu-access-token
MP_WEBHOOK_SECRET=tu-webhook-secret-de-mercadopago

# 3. RESEND (Emails Transaccionales)
RESEND_API_KEY=re_tu_api_key_de_resend
RESEND_FROM_EMAIL="Mirta Cosmética <pedidos@mirtacosmetica.com>"
ADMIN_NOTIFICATION_EMAIL=admin@mirtacosmetica.com

# 4. CORREO ARGENTINO (Opcional: Conector API MiCorreo / Paq.ar)
# Si se dejan vacíos, el sistema utiliza automáticamente el Tarifario editable desde /admin/envios
CORREO_ARGENTINO_API_URL=https://api.correoargentino.com.ar/micorreo/v1
CORREO_ARGENTINO_USER=
CORREO_ARGENTINO_PASSWORD=
CORREO_ARGENTINO_CUSTOMER_ID=
CORREO_ARGENTINO_ORIGIN_CP=1000
